{
  "expo": {
    "name": "DarkPool",
    "slug": "DarkPool",
    "scheme": "com.darkpool.app",
    "version": "1.0.2",
    "sdkVersion": "57.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#F4F2F1",
    "androidStatusBar": {
      "barStyle": "light-content"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.darkpool.app",
      "deploymentTarget": "16.4"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "monochromeImage": "./assets/icon.png",
        "backgroundColor": "#111111"
      },
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.darkpool.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "c6140546-bf96-4ca0-85a5-26807f0742f6"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "mode": "production",
          "icon": "./assets/noti.png",
          "color": "#000000",
          "sounds": []
        }
      ],
      "expo-video",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "נדרשת גישה למצלמה לצילום סטוריז",
          "microphonePermission": "נדרשת גישה למיקרופון להקלטת וידאו"
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "@sentry/react-native",
      "expo-image",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F2F1",
          "image": "./assets/splash-icon-light.png",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-navigation-bar",
        {
          "style": "dark"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "נדרשת גישה למיקרופון להקלטת הודעות קוליות",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsImageWithMaxCount": 10,
            "NSExtensionActivationSupportsMovieWithMaxCount": 10
          },
          "androidIntentFilters": ["text/*", "image/*", "video/*"],
          "androidMultiIntentFilters": ["image/*", "video/*"]
        }
      ],
      "./plugins/withShareSuggestions"
    ],
    "owner": "darkpoolapp"
  },
  "locales": {
    "he": {
      "isRTL": true
    }
  }
}
