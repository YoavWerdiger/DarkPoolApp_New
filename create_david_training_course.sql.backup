-- עדכון משך הקורס לפי סכום כל השיעורים
UPDATE courses 
SET duration_hours = (
  SELECT CEIL(SUM(duration_minutes) / 60.0)
  FROM lessons
  WHERE course_id = 'david-training-course' AND is_active = true
)
WHERE id = 'david-training-course';
