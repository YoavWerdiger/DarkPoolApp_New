{
  "expo": {
    "name": "DarkPool",
    "slug": "DarkPool",
    "scheme": "com.darkpool.app",
    "version": "1.0.1",
    "sdkVersion": "57.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0E0A",
    "androidStatusBar": {
      "barStyle": "light-content"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.darkpool.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "monochromeImage": "./assets/icon.png",
        "backgroundColor": "#000000"
      },
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.darkpool.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "c6140546-bf96-4ca0-85a5-26807f0742f6"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "mode": "production",
          "icon": "./assets/noti.png",
          "color": "#000000",
          "sounds": []
        }
      ],
      "expo-video",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "נדרשת גישה למצלמה לצילום סטוריז",
          "microphonePermission": "נדרשת גישה למיקרופון להקלטת וידאו"
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "@sentry/react-native",
      "expo-image",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-navigation-bar",
        {
          "style": "dark"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "נדרשת גישה למיקרופון להקלטת הודעות קוליות",
          "recordAudioAndroid": true
        }
      ]
    ],
    "owner": "darkpoolapp"
  },
  "locales": {
    "he": {
      "isRTL": true
    }
  }
}
