# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Benzinga
EXPO_PUBLIC_BENZINGA_API_KEY=your-benzinga-api-key

# EODHD — client embeds + Edge Function secret for full US earnings calendar
# (daily-earnings-sync-v2 merges EODHD with earningshub; no market-cap filter)
EXPO_PUBLIC_EODHD_API_KEY=your-eodhd-api-key
# Also set as Supabase Edge secret: supabase secrets set EODHD_API_KEY=...

# RapidAPI (Fear & Greed Index)
EXPO_PUBLIC_RAPIDAPI_KEY=your-rapidapi-key

# CardCom — DO NOT put ApiName / ApiPassword / Terminal in EXPO_PUBLIC_* (they ship in the app binary).
# Configure via Admin → CardCom (table cardcom_config) or Supabase Edge secrets:
#   CARDCOM_API_NAME, CARDCOM_API_PASSWORD, CARDCOM_TERMINAL_NUMBER, CARDCOM_OPERATION
# Temporary E2E test only (create-payment): charge this ILS to CardCom instead of plan price.
#   supabase secrets set CARDCOM_TEST_AMOUNT_ILS=1
#   supabase secrets unset CARDCOM_TEST_AMOUNT_ILS
# Optional client kill-switch only:
# EXPO_PUBLIC_CARDCOM_CHECKOUT_ENABLED=false

# Sentry Error Tracking
EXPO_PUBLIC_SENTRY_DSN=your-sentry-dsn

# Brandfetch (לוגואי טיקרים — אופציונלי; יש ברירת מחדל ציבורית בקוד)
# EXPO_PUBLIC_BRANDFETCH_CLIENT_ID=
