{
  "cli": {
    "version": ">= 16.24.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "node": "20.18.1",
      "env": {
        "NODE_OPTIONS": "--max-old-space-size=8192"
      },
      "android": {
        "buildType": "app-bundle",
        "image": "latest"
      },
      "cache": {
        "key": "production-cache-v1",
        "paths": [
          "node_modules",
          "android/.gradle"
        ]
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account-key.json",
        "track": "production"
      }
    }
  }
}
