{
  "expo": {
    "name": "DarkPool",
    "slug": "DarkPool",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.darkpool.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.darkpool.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "c6140546-bf96-4ca0-85a5-26807f0742f6"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "mode": "production",
          "icon": "./assets/icon.png",
          "color": "#000000",
          "sounds": []
        }
      ]
    ],
    "notification": {
      "icon": "./assets/icon.png",
      "color": "#000000",
      "androidMode": "default",
      "androidCollapsedTitle": "DarkPool",
      "iosDisplayInForeground": true,
      "androidDisplayInForeground": true
    },
    "bundler": "metro",
    "owner": "darkpoolapp",
    "scheme": "com.darkpool.app"
  },
  "locales": {
    "he": {
      "isRTL": true
    }
  }
}
